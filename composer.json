{
    "name": "whmcs-marketplace/whmcs-marketplace",
    "description": "Multi-vendor digital marketplace for WHMCS with a companion WordPress plugin (development workspace).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "illuminate/database": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WhmcsMarketplace\\": "whmcs/modules/addons/marketplace/src/",
            "WhmcsMarketplace\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit"
    }
}
